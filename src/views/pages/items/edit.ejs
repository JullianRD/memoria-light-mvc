<!-- views.pages/items/edit.ejs -->

<div class="form-container">
    <form action="/items/<%= item.id %>/update" method="POST">

        <h3>Modifier la pépite</h3>

        <div style="display: flex; gap: 10px;">
            <label for="title">Titre:</label>
            <input type="text" name="title" value="<%= item.title %>" required style="flex:2">
            <label for="sourceAuthor">Auteur/Source:</label>
            <input type="text" name="sourceAuthor" value="<%= item.sourceAuthor %>" style="flex: 1;">
        </div>
        <label for="content">Contenu:</label>
        <textarea name="content" rows="5" required> <%= item.content %></textarea>
        <div style="display: flex; align-items: center; gap: 15px;">
            <label for="contentType">Source Type: </label>
            <select name="contentType" style="margin-bottom: 0; width: auto;">
                <option value="note" <%=item.contentType==="note" ? "selected" : '' %>>Note</option>
                <option value="article" <%=item.contentType==="article" ? "selected" : '' %>>Article</option>
                <option value="livre" <%=item.contentType==="livre" ? "selected" : '' %>>Livre</option>
                <option value="video" <%=item.contentType==="video" ? "selected" : '' %>>Video</option>
            </select>
            <button type="submit">Modifier la pépite</button>
            <button type="reset">Réinitialiser</button>
            <a href="/items/<%= item.id %>">Retour</a>
        </div>

    </form>

</div>
