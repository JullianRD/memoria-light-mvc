# ============================================================================
# FICHIER MODÈLE DE CONFIGURATION (.env.example)
# ============================================================================
#
# 📖 INSTRUCTIONS :
# 1. Copier ce fichier et le renommer en ".env"
# 2. Remplir les valeurs manquantes
# 3. Ne JAMAIS commiter le fichier .env (vérifier .gitignore)
#
# 💡 Ce fichier sert de documentation pour les autres développeurs
# ============================================================================

# Configuration Serveur
PORT=3000
NODE_ENV=development

# Configuration Base de Données (Détails)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memoria_db_dev
DB_USER=postgres
DB_PASSWORD=
DB_APP_USER=app_memoria
DB_APP_PASSWORD=

# Connection String PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://app_memoria:PASSWORD@localhost:5432/memoria_db_dev
